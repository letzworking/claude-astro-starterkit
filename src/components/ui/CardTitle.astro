---
import { cn } from '@/lib/utils';

interface Props {
  /** 문서 구조에 맞는 제목 태그 (기본값 h3) */
  as?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const { as: Tag = 'h3', class: className } = Astro.props;
---

<Tag class={cn('text-2xl font-semibold leading-none tracking-tight', className)}>
  <slot />
</Tag>
